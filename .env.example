# Postgres. If unset, the API uses an in-memory DB (pg-mem) that resets on restart.
DATABASE_URL=postgres://user:pass@localhost:5432/tradejobs
PGSSL=
PORT=3001
# Public base URL for Stripe return links (optional)
PUBLIC_URL=
# Optional: enables "Pay by card" on invoices via Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
# Optional: Resend email module (stub, never called automatically)
RESEND_API_KEY=
RESEND_FROM=
# Set to 1 to seed demo shop on first boot against real Postgres
SEED_ON_START=
